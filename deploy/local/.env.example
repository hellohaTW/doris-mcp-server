# Copy to `.env` in this directory, then edit. Compose reads it automatically
# because the project directory is the directory holding docker-compose.yml.
# Secrets are NOT set here; they live in ./secrets/ as files.

# --- Doris route -----------------------------------------------------------
# Doris running on your host machine (Docker Desktop and Linux both work
# through the extra_hosts entry in docker-compose.yml):
DORIS_HOST=host.docker.internal
# Doris started by the optional `doris` profile in this same file:
# DORIS_HOST=doris-fe
# A remote cluster:
# DORIS_HOST=doris-fe.internal.example.com

DORIS_PORT=9030
DORIS_USER=mcp_reader
DORIS_DATABASE=information_schema

# FE/BE HTTP ports, used by cluster and profiling capabilities.
DORIS_FE_HTTP_PORT=8030
DORIS_BE_WEBSERVER_PORT=8040

# --- Local HTTP listener ---------------------------------------------------
# Host port for http://127.0.0.1:<port>/mcp. Change it if 3000 is taken.
MCP_HTTP_PORT=3000

# Host/Origin allowlists. The container binds 0.0.0.0, so these must name the
# addresses your MCP Host actually uses.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# Enable only for Hosts stuck on handshake-era Streamable HTTP (Dify 1.16.1).
ENABLE_LEGACY_HTTP_ADAPTER=false

# --- Bounds and logging ----------------------------------------------------
DORIS_MIN_CONNECTIONS=2
DORIS_MAX_CONNECTIONS=10
MAX_RESULT_ROWS=10000
DEFAULT_RESULT_ROWS=100
MAX_RESULT_BYTES=1048576
QUERY_TIMEOUT=300
MAX_CONCURRENT_QUERIES=20
LOG_LEVEL=INFO

# --- Optional `doris` profile ports ---------------------------------------
# Only used with `docker compose --profile doris up -d`.
DORIS_FE_HTTP_PUBLISHED_PORT=8030
DORIS_FE_QUERY_PUBLISHED_PORT=9030
